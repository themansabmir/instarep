// Instarep database schema (PostgreSQL + pgvector).
//
// Conventions:
// - Models are PascalCase singular; tables/columns are snake_case via @@map/@map.
// - UUID primary keys, timestamptz-free `timestamp(6)` columns to match the spec.
// - Status/role/enum-like fields are varchar with defaults (kept flexible for MVP).
// - Referential actions: owned children Cascade; optional references SetNull;
//   plan references are Restrict so plans cannot be deleted out from under a
//   live subscription.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ============================================================
// USERS & WORKSPACES
// ============================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String?   @db.VarChar(150)
  emailVerified Boolean   @default(false) @map("email_verified")
  avatarUrl     String?   @map("avatar_url") @db.Text
  status        String    @default("active") @db.VarChar(30)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  sessions        Session[]
  accounts        Account[]
  ownedWorkspaces Workspace[]
  memberships     WorkspaceMember[]
  notifications   Notification[]
  emailEvents     EmailEvent[]
  analyticsEvents AnalyticsEvent[]
  adminUser       AdminUser?
  auditLogs       AuditLog[]
  oauthStates     OAuthState[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(255)
  issuer                String    @db.VarChar(255)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "accounts_issuer_account_id_key")
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([identifier])
  @@map("verifications")
}

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  ownerUserId String   @map("owner_user_id") @db.Uuid
  status      String   @default("active") @db.VarChar(30)
  timezone    String   @default("UTC") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  members              WorkspaceMember[]
  instagramAccounts    InstagramAccount[]
  avatars              Avatar[]
  knowledgeBases       KnowledgeBase[]
  instagramComments    InstagramComment[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  conversations        Conversation[]
  leads                Lead[]
  subscriptions        Subscription[]
  payments             Payment[]
  creditAccount        CreditAccount?
  creditTransactions   CreditTransaction[]
  notifications        Notification[]
  emailEvents          EmailEvent[]
  analyticsEvents      AnalyticsEvent[]
  auditLogs            AuditLog[]
  oauthStates          OAuthState[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("member") @db.VarChar(30)
  status      String   @default("active") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ============================================================
// INSTAGRAM INTEGRATION
// ============================================================

model InstagramAccount {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  instagramUserId      String    @unique @map("instagram_user_id") @db.VarChar(100)
  username             String?   @db.VarChar(150)
  displayName          String?   @map("display_name") @db.VarChar(150)
  profilePictureUrl    String?   @map("profile_picture_url") @db.Text
  biography            String?   @db.Text
  followersCount       Int?      @map("followers_count")
  followingCount       Int?      @map("following_count")
  mediaCount           Int?      @map("media_count")
  accessTokenEncrypted String?   @map("access_token_encrypted") @db.Text
  tokenExpiresAt       DateTime? @map("token_expires_at") @db.Timestamp(6)
  status               String    @default("CONNECTING") @db.VarChar(30)
  connectedAt          DateTime? @map("connected_at") @db.Timestamp(6)
  disconnectedAt       DateTime? @map("disconnected_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  comments        InstagramComment[]
  automations     Automation[]
  conversations   Conversation[]
  analyticsEvents AnalyticsEvent[]
  webhookEvents   InstagramWebhookEvent[]

  @@index([workspaceId])
  @@index([username])
  @@map("instagram_accounts")
}

model OAuthState {
  id          String   @id @default(uuid()) @db.Uuid
  state       String   @unique @db.VarChar(255)
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(50)
  expiresAt   DateTime @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
  @@map("oauth_states")
}

model InstagramWebhookEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  instagramAccountId String?   @map("instagram_account_id") @db.Uuid
  externalEventId    String    @unique @map("external_event_id") @db.VarChar(255)
  eventType          String    @map("event_type") @db.VarChar(100)
  payload            Json      @db.JsonB
  status             String    @default("pending") @db.VarChar(30)
  processedAt        DateTime? @map("processed_at") @db.Timestamp(6)
  errorMessage       String?   @map("error_message") @db.Text
  retryCount         Int       @default(0) @map("retry_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([instagramAccountId])
  @@index([createdAt])
  @@map("instagram_webhook_events")
}

// ============================================================
// AVATAR / AI CONFIGURATION
// ============================================================

model Avatar {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  personality     String?  @db.Text
  tone            String?  @db.VarChar(50)
  language        String   @default("English") @db.VarChar(50)
  systemPrompt    String?  @map("system_prompt") @db.Text
  greetingMessage String?  @map("greeting_message") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  automations   Automation[]
  conversations Conversation[]

  @@index([workspaceId])
  @@map("avatars")
}

// ============================================================
// KNOWLEDGE BASE / RAG
// ============================================================

model KnowledgeBase {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  status      String   @default("active") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@index([workspaceId])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String   @id @default(uuid()) @db.Uuid
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid
  title           String   @db.VarChar(255)
  sourceType      String   @map("source_type") @db.VarChar(50)
  sourceUrl       String?  @map("source_url") @db.Text
  fileUrl         String?  @map("file_url") @db.Text
  content         String?  @db.Text
  contentHash     String?  @map("content_hash") @db.VarChar(128)
  status          String   @default("pending") @db.VarChar(30)
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @map("document_id") @db.Uuid
  chunkIndex Int                          @map("chunk_index")
  content    String                       @db.Text
  tokenCount Int?                         @map("token_count")
  embedding  Unsupported("vector(1536)")?
  metadata   Json?                        @db.JsonB
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

// ============================================================
// COMMENT INTELLIGENCE
// ============================================================

model InstagramComment {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  instagramAccountId String    @map("instagram_account_id") @db.Uuid
  instagramCommentId String    @unique @map("instagram_comment_id") @db.VarChar(150)
  instagramMediaId   String?   @map("instagram_media_id") @db.VarChar(150)
  instagramUserId    String?   @map("instagram_user_id") @db.VarChar(150)
  username           String?   @db.VarChar(150)
  commentText        String    @map("comment_text") @db.Text
  sentiment          String?   @db.VarChar(30)
  intent             String?   @db.VarChar(50)
  language           String?   @db.VarChar(30)
  aiAnalysis         Json?     @map("ai_analysis") @db.JsonB
  commentedAt        DateTime? @map("commented_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  automationExecutions AutomationExecution[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([instagramMediaId])
  @@index([commentedAt])
  @@map("instagram_comments")
}

// ============================================================
// AUTO DM AUTOMATIONS
// ============================================================

model Automation {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  instagramAccountId String   @map("instagram_account_id") @db.Uuid
  avatarId           String?  @map("avatar_id") @db.Uuid
  name               String   @db.VarChar(150)
  description        String?  @db.Text
  triggerType        String   @map("trigger_type") @db.VarChar(50)
  triggerConfig      Json?    @map("trigger_config") @db.JsonB
  responseMode       String   @default("ai") @map("response_mode") @db.VarChar(30)
  status             String   @default("draft") @db.VarChar(30)
  maxMessagesPerUser Int?     @map("max_messages_per_user")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  avatar           Avatar?          @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  executions    AutomationExecution[]
  conversations Conversation[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([avatarId])
  @@map("automations")
}

model AutomationExecution {
  id              String    @id @default(uuid()) @db.Uuid
  automationId    String    @map("automation_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  instagramUserId String?   @map("instagram_user_id") @db.VarChar(150)
  commentId       String?   @map("comment_id") @db.Uuid
  conversationId  String?   @map("conversation_id") @db.Uuid
  status          String    @db.VarChar(30)
  errorMessage    String?   @map("error_message") @db.Text
  startedAt       DateTime? @map("started_at") @db.Timestamp(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  automation   Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comment      InstagramComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([automationId])
  @@index([createdAt])
  @@map("automation_executions")
}

// ============================================================
// AI CONVERSATIONS
// ============================================================

model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  instagramAccountId String    @map("instagram_account_id") @db.Uuid
  automationId       String?   @map("automation_id") @db.Uuid
  avatarId           String?   @map("avatar_id") @db.Uuid
  instagramUserId    String    @map("instagram_user_id") @db.VarChar(150)
  instagramUsername  String?   @map("instagram_username") @db.VarChar(150)
  status             String    @default("active") @db.VarChar(30)
  source             String?   @db.VarChar(50)
  leadStatus         String    @default("new") @map("lead_status") @db.VarChar(30)
  startedAt          DateTime? @map("started_at") @db.Timestamp(6)
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamp(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automation       Automation?      @relation(fields: [automationId], references: [id], onDelete: SetNull)
  avatar           Avatar?          @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  messages             ConversationMessage[]
  leads                Lead[]
  automationExecutions AutomationExecution[]
  analyticsEvents      AnalyticsEvent[]

  @@index([workspaceId])
  @@index([instagramUserId])
  @@index([lastMessageAt])
  @@index([instagramAccountId])
  @@index([automationId])
  @@index([avatarId])
  @@map("conversations")
}

model ConversationMessage {
  id                 String   @id @default(uuid()) @db.Uuid
  conversationId     String   @map("conversation_id") @db.Uuid
  role               String   @db.VarChar(30)
  content            String   @db.Text
  messageType        String   @default("text") @map("message_type") @db.VarChar(30)
  instagramMessageId String?  @map("instagram_message_id") @db.VarChar(150)
  aiModel            String?  @map("ai_model") @db.VarChar(100)
  tokenUsage         Int?     @map("token_usage")
  retrievedChunkIds  Json?    @map("retrieved_chunk_ids") @db.JsonB
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("conversation_messages")
}

// ============================================================
// LEADS / CONVERSION
// ============================================================

model Lead {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  conversationId  String?   @map("conversation_id") @db.Uuid
  instagramUserId String    @map("instagram_user_id") @db.VarChar(150)
  username        String?   @db.VarChar(150)
  status          String    @default("new") @db.VarChar(30)
  source          String?   @db.VarChar(50)
  convertedAt     DateTime? @map("converted_at") @db.Timestamp(6)
  metadata        Json?     @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  analyticsEvents AnalyticsEvent[]

  @@index([workspaceId])
  @@index([status])
  @@index([instagramUserId])
  @@index([conversationId])
  @@map("leads")
}

// ============================================================
// BILLING / SUBSCRIPTIONS
// ============================================================

model SubscriptionPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(100)
  slug                 String   @unique @db.VarChar(100)
  description          String?  @db.Text
  price                Decimal  @db.Decimal(12, 2)
  currency             String   @default("USD") @db.VarChar(10)
  billingInterval      String   @map("billing_interval") @db.VarChar(30)
  includedCredits      BigInt   @default(0) @map("included_credits")
  maxInstagramAccounts Int?     @map("max_instagram_accounts")
  maxKnowledgeBases    Int?     @map("max_knowledge_bases")
  maxConversations     Int?     @map("max_conversations")
  features             Json?    @db.JsonB
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  planId                 String    @map("plan_id") @db.Uuid
  provider               String?   @db.VarChar(50)
  providerSubscriptionId String?   @map("provider_subscription_id") @db.VarChar(255)
  status                 String    @db.VarChar(30)
  currentPeriodStart     DateTime? @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamp(6)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime? @map("canceled_at") @db.Timestamp(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@index([workspaceId])
  @@index([providerSubscriptionId])
  @@index([status])
  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  subscriptionId    String?   @map("subscription_id") @db.Uuid
  provider          String    @db.VarChar(50)
  providerPaymentId String?   @map("provider_payment_id") @db.VarChar(255)
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @db.VarChar(10)
  status            String    @db.VarChar(30)
  paymentType       String?   @map("payment_type") @db.VarChar(30)
  metadata          Json?     @db.JsonB
  paidAt            DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([providerPaymentId])
  @@index([createdAt])
  @@map("payments")
}

// ============================================================
// CREDIT SYSTEM
// ============================================================

model CreditAccount {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @unique @map("workspace_id") @db.Uuid
  balance         BigInt   @default(0)
  lifetimeCredits BigInt   @default(0) @map("lifetime_credits")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_accounts")
}

model CreditTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  creditAccountId String   @map("credit_account_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  amount          BigInt
  transactionType String   @map("transaction_type") @db.VarChar(50)
  referenceType   String?  @map("reference_type") @db.VarChar(50)
  referenceId     String?  @map("reference_id") @db.Uuid
  description     String?  @db.Text
  balanceAfter    BigInt?  @map("balance_after")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([creditAccountId])
  @@index([createdAt])
  @@map("credit_transactions")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(255)
  message     String?   @db.Text
  data        Json?     @db.JsonB
  readAt      DateTime? @map("read_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([readAt])
  @@map("notifications")
}

model EmailEvent {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  emailType         String    @map("email_type") @db.VarChar(50)
  recipientEmail    String    @map("recipient_email") @db.VarChar(255)
  provider          String?   @db.VarChar(50)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(255)
  status            String    @db.VarChar(30)
  metadata          Json?     @db.JsonB
  sentAt            DateTime? @map("sent_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@map("email_events")
}

// ============================================================
// ANALYTICS / EVENTS
// ============================================================

model AnalyticsEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String?  @map("workspace_id") @db.Uuid
  eventType          String   @map("event_type") @db.VarChar(100)
  userId             String?  @map("user_id") @db.Uuid
  instagramAccountId String?  @map("instagram_account_id") @db.Uuid
  conversationId     String?  @map("conversation_id") @db.Uuid
  leadId             String?  @map("lead_id") @db.Uuid
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  instagramAccount InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  conversation     Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@index([instagramAccountId])
  @@index([conversationId])
  @@index([leadId])
  @@map("analytics_events")
}

// ============================================================
// SUPERADMIN
// ============================================================

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  role      String   @default("admin") @db.VarChar(30)
  status    String   @default("active") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  oldValues   Json?    @map("old_values") @db.JsonB
  newValues   Json?    @map("new_values") @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([adminUserId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
