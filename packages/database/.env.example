# PostgreSQL connection string used by Prisma (migrations, studio, runtime).
# The database must have the pgvector extension available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instarep?schema=public"

# Optional: a direct (non-pooled) connection for migrations when using a pooler
# such as PgBouncer. Falls back to DATABASE_URL if unset.
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/instarep?schema=public"
