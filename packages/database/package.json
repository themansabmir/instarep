{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ./scripts/run-prisma.mjs generate",
    "db:generate": "node ./scripts/run-prisma.mjs generate",
    "db:migrate": "node ./scripts/run-prisma.mjs migrate dev",
    "db:deploy": "node ./scripts/run-prisma.mjs migrate deploy",
    "db:push": "node ./scripts/run-prisma.mjs db push",
    "db:studio": "node ./scripts/run-prisma.mjs studio",
    "db:seed": "node --import ./scripts/load-product-env.mjs --import tsx prisma/seed.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "node ./scripts/run-prisma.mjs generate && tsc --noEmit",
    "clean": "rimraf src/generated .turbo node_modules"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
