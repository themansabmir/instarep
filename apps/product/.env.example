# URL this product app is served from

NEXT_PUBLIC_APP_URL="http://localhost:3001"



# URL of the marketing website

NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"



# development | preview | production

NEXT_PUBLIC_APP_ENV="development"



# PostgreSQL connection (Prisma / @repo/db). Requires the pgvector extension.

DATABASE_URL="postgresql://postgres:123456@localhost:5432/instarep?schema=public"



# Better Auth

BETTER_AUTH_SECRET="replace-with-at-least-32-characters-secret-key"

BETTER_AUTH_URL="http://localhost:3001"



# SMTP (Gmail app password — email verification + password reset)

SMTP_HOST="smtp.gmail.com"

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER="your@gmail.com"

SMTP_PASS="your-gmail-app-password"

EMAIL_FROM="your@gmail.com"

# In development: log action links and do not fail signup if SMTP errors

EMAIL_OTP_DEV_FALLBACK=true



# Instagram / Meta

INSTAGRAM_APP_ID=""

INSTAGRAM_APP_SECRET=""

INSTAGRAM_REDIRECT_URI="http://localhost:3001/api/instagram/callback"

INSTAGRAM_API_BASE_URL="https://graph.instagram.com"

INSTAGRAM_API_VERSION="v21.0"



# 32-byte key, base64-encoded (generate: openssl rand -base64 32)

TOKEN_ENCRYPTION_KEY=""



# Meta webhook verification token (set in Meta developer console)

META_WEBHOOK_VERIFY_TOKEN=""



# Protects cron retry endpoint

CRON_SECRET="replace-with-random-secret"

