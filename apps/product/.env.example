# URL this product app is served from
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# URL of the marketing website
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"

# development | preview | production
NEXT_PUBLIC_APP_ENV="development"

# PostgreSQL connection (Prisma / @repo/db). Requires the pgvector extension.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instarep?schema=public"

# Server-only secrets (never prefixed with NEXT_PUBLIC_). Add as features land:
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/instarep?schema=public"
# STRIPE_SECRET_KEY="sk_test_..."
